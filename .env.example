# ==========================================
# Startup Connect AI — Environment Variables
# ==========================================
# Copy this file to .env and fill in real values.
# Never commit .env to git.

# ---------- Frontend (Next.js) ----------
# Public vars (exposed to browser — must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk (get from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXX
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/home
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Supabase (public URL is fine to expose)
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------- Backend (FastAPI) ----------
# Environment: development | staging | production
ENVIRONMENT=development
LOG_LEVEL=info

# Supabase (backend uses service role for privileged ops)
SUPABASE_URL=https://XXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
DATABASE_URL=postgresql://postgres:PASSWORD@db.XXXXX.supabase.co:5432/postgres

# Clerk backend
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXX
CLERK_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX

# Qdrant Cloud
QDRANT_URL=https://XXXXXXXX.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=eyJhbGciOi...
QDRANT_COLLECTION=profiles

# LLM — primary
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXX
GROQ_MODEL=llama-3.1-70b-versatile

# LLM — fallback (only used when Groq fails)
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-4o-mini

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=XXXXXXXXXXXXXXXX
R2_ACCESS_KEY_ID=XXXXXXXXXXXXXXXX
R2_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXX
R2_BUCKET_NAME=startup-connect-media
R2_PUBLIC_URL=https://media.startupconnect.ai

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://XXXX.upstash.io
UPSTASH_REDIS_REST_TOKEN=XXXXXXXXXXXXXXXX

# CORS (frontend origin allowed to hit backend)
CORS_ORIGINS=http://localhost:3000,https://startupconnect.ai
