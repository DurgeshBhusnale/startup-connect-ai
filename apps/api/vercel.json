{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "app/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/v1/jobs/meeting-notifications",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/v1/jobs/compute-trust",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/v1/jobs/purge-accounts",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/v1/jobs/purge-posts",
      "schedule": "30 3 * * *"
    }
  ]
}
