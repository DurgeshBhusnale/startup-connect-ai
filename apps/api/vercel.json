{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/main.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/v1/jobs/meeting-notifications",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/v1/jobs/compute-trust",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/v1/jobs/purge-accounts",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/v1/jobs/purge-posts",
      "schedule": "30 3 * * *"
    }
  ]
}
